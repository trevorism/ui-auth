{
  "name": "@trevorism/ui-auth",
  "version": "1.0.1",
  "description": "Browser session handling for Trevorism.com apps",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "accept": "vitest run --environment jsdom",
    "format": "prettier --write \"{src,test}/**/*.js\" ./*.js",
    "test": "vitest --environment jsdom",
    "prepublishOnly": "npm run build && npm run accept",
    "webstorm-integration": "vitest --watch --reporter=dot --reporter=json --outputFile=.vitest-result.json"
  },
  "main": "./dist/ui-auth.umd.cjs",
  "module": "./dist/ui-auth.es.js",
  "exports": {
    ".": {
      "import": "./dist/ui-auth.es.js",
      "require": "./dist/ui-auth.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axios": "^1.13.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.8.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.18",
    "vue-router": "^5.2.0"
  },
  "peerDependencies": {
    "axios": ">=1",
    "vue": "^3.3.0",
    "vue-router": ">=4"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevorism/ui-auth.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
